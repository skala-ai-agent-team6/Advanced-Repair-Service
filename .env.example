OPENAI_API_KEY=
# 아래는 Spring과 붙일 때만
INTERNAL_SERVICE_TOKEN=
SPRING_BASE_URL=http://localhost:8080
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# 기존 Agent consumer와 동시에 운영하지 말 것. e2e_check는 실제 Spring 접수를 생성한다.
GROUP_ID=skeleton-integration
OBSERVATION_MCP_URL=http://127.0.0.1:8011/mcp
PCB_INTERPRET_MCP_URL=http://127.0.0.1:8012/mcp
DAMAGE_MCP_URL=http://127.0.0.1:8013/mcp
RAG_MCP_URL=http://127.0.0.1:8014/mcp
MECH_MCP_URL=http://127.0.0.1:9104/mcp
RECURSION_LIMIT=20
# 한 Kafka 이벤트 안에서 노드 실행 합계 / 동일 도구+동일 입력의 시도 횟수 (재시도 포함)
MAX_NODE_EXECUTIONS=20
MAX_SAME_INPUT_ATTEMPTS=3
TOOL_TIMEOUT=90
RUN_TIMEOUT=1800
# Kafka 대기 한도는 실행 한도 + 180초 이상으로 자동 보정됨 (기본 1,980,000ms)
KAFKA_MAX_POLL_INTERVAL_MS=1980000
MAX_TOOL_CALLS=2000
BUSINESS_MCP_URL=https://dc65-211-45-60-3.ngrok-free.app/mcp
# Spring MCP_TOKEN과 같은 내부 인증 토큰을 설정
BUSINESS_GATEWAY_TOKEN=

# 새 로컬 검증 그룹만 latest 사용. 워커 준비 후 접수해야 한다.
KAFKA_AUTO_OFFSET_RESET=earliest

# MCP 응답 hard cap / LLM용 텍스트 사본 크기 (UTF-8 bytes)
MAX_MCP_RESPONSE_BYTES=262144
OBSERVATION_CONTEXT_BYTES=6000
TOOL_CONTEXT_BYTES=8000
REPORT_FINDINGS_BYTES=24000
# Agent 직접 LLM 호출에만 적용. 이미지 예약량은 추정치, MCP 내부 비용은 제외.
MAX_CONTEXT_TOKENS=64000
MAX_OUTPUT_TOKENS=2048
MAX_RUN_TOKENS=800000
IMAGE_TOKEN_RESERVE=50000
MAX_EVENT_BYTES=750000

# 클라우드 DB (팀 공용). 있으면 ./run.sh가 로컬 Postgres 대신 이 DB를 쓴다. 비밀번호는 팀에 문의
#Host=34.64.242.87
#Port=5432
#Database=repair
#username=postgres
#password=
